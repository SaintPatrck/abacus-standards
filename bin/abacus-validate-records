#!/bin/sh
# abacus-validate-records: validate retro/decision record headers against closed vocabularies.
#
# Usage: abacus-validate-records [file-or-dir ...]   (default: docs/retros docs/adr docs/decisions docs/postmortems)
#
# Validates every document that claims a profile (any profile key other than
# `date`), skips documents with no profile but prints the skip count, and FAILS
# if it validated nothing. It never warns and continues. Needs only sh, sed, grep.
# Extending a vocabulary needs a decision record in abacus-standards.

DOC_TYPES="retro postmortem adr decision bead outcome mined-retro"
TRIGGERS="intractable fix-loop-cap gate-red-on-main escalation manual incident release audit mined unknown"
SURFACES="workflow build tests deps infra design process data retrieval security cost docs unknown"
SEVERITIES="sev1 sev2 sev3 sev4 unknown"
RESOLVED="true false partial unknown"
KEYS="id project issue date doc_type trigger surface severity resolved tags"
HARVEST_ONLY="era source_path source_format inferred"

validated=0; skipped=0; failed=0

in_list() { # value list
  for x in $2; do [ "$x" = "$1" ] && return 0; done; return 1
}

header() { # file -> prints frontmatter lines (between first two --- lines)
  sed -n '1{/^---$/!q;};1d;/^---$/q;p' "$1"
}

check_file() {
  f=$1
  h=$(header "$f")
  claims=$(printf '%s\n' "$h" | grep -E '^(id|project|issue|doc_type|trigger|surface|severity|resolved|tags):' | head -1)
  if [ -z "$claims" ]; then skipped=$((skipped + 1)); return; fi
  errs=""
  for k in $KEYS; do
    printf '%s\n' "$h" | grep -qE "^$k:" || errs="$errs; missing key: $k"
  done
  for k in $(printf '%s\n' "$h" | sed -n 's/^\([A-Za-z_][A-Za-z0-9_]*\):.*/\1/p'); do
    if in_list "$k" "$HARVEST_ONLY"; then errs="$errs; $k is a harvest fact, never write it"
    elif ! in_list "$k" "$KEYS"; then errs="$errs; unknown key: $k"; fi
  done
  val() { printf '%s\n' "$h" | sed -n "s/^$1:[[:space:]]*//p" | sed 's/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//' | head -1; }
  v=$(val doc_type);  [ -n "$v" ] && ! in_list "$v" "$DOC_TYPES"  && errs="$errs; doc_type '$v' not in: $DOC_TYPES"
  v=$(val trigger);   [ -n "$v" ] && ! in_list "$v" "$TRIGGERS"   && errs="$errs; trigger '$v' not in: $TRIGGERS"
  v=$(val surface);   [ -n "$v" ] && ! in_list "$v" "$SURFACES"   && errs="$errs; surface '$v' not in: $SURFACES"
  v=$(val severity);  [ -n "$v" ] && ! in_list "$v" "$SEVERITIES" && errs="$errs; severity '$v' not in: $SEVERITIES"
  v=$(val resolved);  [ -n "$v" ] && ! in_list "$v" "$RESOLVED"   && errs="$errs; resolved '$v' not in: $RESOLVED"
  v=$(val project);   printf '%s' "$v" | grep -qE '^[a-z0-9-]+$' || errs="$errs; project must be lowercase [a-z0-9-]"
  v=$(val date);      printf '%s' "$v" | grep -qE '^[0-9]{4}-[0-9]{2}-[0-9]{2}$' || errs="$errs; date must be YYYY-MM-DD"
  v=$(val tags);      printf '%s' "$v" | grep -qE '^\[.*\]$' || errs="$errs; tags must be a [list]"
  if [ -n "$errs" ]; then
    echo "INVALID $f${errs}" >&2
    failed=$((failed + 1))
  else
    validated=$((validated + 1))
  fi
}

[ $# -eq 0 ] && set -- docs/retros docs/adr docs/decisions docs/postmortems
for target in "$@"; do
  if [ -d "$target" ]; then
    for f in "$target"/*.md; do [ -f "$f" ] && check_file "$f"; done
  elif [ -f "$target" ]; then
    check_file "$target"
  fi
done

echo "validated $validated, skipped $skipped (no profile), invalid $failed"
[ "$failed" -gt 0 ] && exit 1
if [ "$validated" -eq 0 ]; then
  echo "FAIL: validated nothing (zero validated is not green)" >&2
  exit 1
fi
exit 0
